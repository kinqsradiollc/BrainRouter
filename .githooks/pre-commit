#!/bin/sh
# BrainRouter pre-commit hook (Refactor R0.3).
# Lints ONLY the staged TS/JS files so a lint error is caught here rather than in
# CI. Deliberately no `prettier --write` (would reformat the not-yet-formatted
# tree and churn every commit) and no full build/test (too slow for a hook).
#
# Bypass:  git commit --no-verify   OR   BR_SKIP_HOOKS=1 git commit ...
set -e

if [ "$BR_SKIP_HOOKS" = "1" ]; then
  echo "pre-commit: skipped (BR_SKIP_HOOKS=1)"
  exit 0
fi

# Staged Added/Copied/Modified source files (exclude deletions + dist output).
files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(ts|tsx|js|mjs|cjs)$' \
  | grep -vE '(^|/)(dist|dist-electron|node_modules)/' \
  || true)

boundary_changed=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '(^|/)(package\.json|[^/]+\.(ts|tsx|js|mjs|cjs))$' \
  | grep -vE '(^|/)(dist|dist-electron|node_modules)/' \
  || true)

# Every staged text file (the NUL gate filters by extension itself). A raw 0x00
# byte inside a string is invisible in editors and diffs and turns the file
# binary for git; sentinels are written as the `\0` escape instead.
text_files=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -vE '(^|/)(dist|dist-electron|node_modules)/' \
  || true)

# text_files is a superset of the two lists above, so it alone decides "nothing staged".
if [ -z "$text_files" ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)

if [ -n "$text_files" ]; then
  # Needs only node, so it runs before the eslint-availability check below.
  # shellcheck disable=SC2086
  node "$root/scripts/check-no-raw-nul.mjs" --files $text_files
fi

if [ -z "$files" ] && [ -z "$boundary_changed" ]; then
  exit 0
fi

# Resolve a local eslint; if it isn't installed (fresh clone before `npm ci`),
# skip rather than hard-block — the hook must never wedge an otherwise-valid repo.
eslint_bin="$root/node_modules/.bin/eslint"
if [ ! -x "$eslint_bin" ]; then
  echo "pre-commit: eslint not installed (run npm ci) — skipping lint."
  exit 0
fi

echo "pre-commit: linting staged files…"
if [ -n "$boundary_changed" ]; then
  # shellcheck disable=SC2086
  node "$root/scripts/check-package-boundaries.mjs" --files $files
fi
if [ -n "$files" ]; then
  # shellcheck disable=SC2086
  "$eslint_bin" --no-error-on-unmatched-pattern $files
fi
