# Copy to deploy/dev/.env and fill in. Only the `brain` profile needs the secrets;
# the STT-only default run needs none of these.

# Shared JWT signing secret — MUST match whatever your host `npm run dev:http` uses
# (so account tokens validate). Any strong random string in dev.
BRAINROUTER_JWT_SECRET=

# AES-256-GCM key (32-byte base64 or hex) that seals provider/integration secrets.
# MUST match your host value or sealed keys won't decrypt.
BRAINROUTER_SECRET_KEY=

# Reuse the already-running host postgres (default matches deploy/stack).
BRAINROUTER_DATABASE_URL=postgres://postgres:postgres@host.docker.internal:5432/brainrouter

# The brain reaches the STT sidecar by its compose name when run in-container.
BRAINROUTER_STT_URL=http://stt:3752

# Optional read cache. Compose already points the brain at the bundled redis;
# only set this to override (e.g. an external Redis). Unset = in-process cache.
# BRAINROUTER_REDIS_URL=redis://redis:6379

# Whisper model (baked default is ggml-base.en.bin). Override the URL at build time
# for another ggml, e.g. .../resolve/main/ggml-small.bin
WHISPER_MODEL=/models/ggml-base.en.bin
# WHISPER_THREADS=

# Allow the dashboard origin (browser) to call :3747 in the brain-in-docker mode.
BRAINROUTER_CORS_ORIGIN=http://localhost:3000
# Public base for shareable meeting links (optional).
# BRAINROUTER_PUBLIC_URL=http://localhost:3747

# ── Pentest lens (opt-in, host-isolated) ────────────────────────────────────
# The pentest lens NEVER runs on the host: every command executes in a
# throwaway, read-only Docker sandbox on a per-session network routed through an
# intercepting proxy. Setup (one-time):
#   docker build -f deploy/pentest/Dockerfile -t brainrouter-pentest:local .
#   docker pull mitmproxy/mitmproxy:11.1.3
# Because the brain shells out to `docker` and bind-mounts the job workspace,
# run the brain ON THE HOST for local pentest testing (native Docker socket +
# native paths). Leave these unset to keep the lens disabled; security +
# code-review lenses are unaffected.
# BRAINROUTER_PENTEST_IMAGE=brainrouter-pentest:local
# BRAINROUTER_PENTEST_PROXY_IMAGE=mitmproxy/mitmproxy:11.1.3
# BRAINROUTER_PENTEST_PROXY_URL=http://proxy:8080
# BRAINROUTER_PENTEST_PROXY_API=http://proxy:8081
# Hosted safety: restrict targets to hosts you own (comma-separated; a parent
# domain matches its subdomains). Unset = self-service (single-tenant/local).
# BRAINROUTER_PENTEST_DOMAIN_ALLOWLIST=example.com,staging.example.com
