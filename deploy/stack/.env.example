# BrainRouter production stack — copy to .env and fill in. See README.md.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=brainrouter

# --- Brain (required in production) ---
# JWT signing key. Generate: openssl rand -hex 32
BRAINROUTER_JWT_SECRET=
# AES-256-GCM KEK that encrypts provider/integration API keys at rest (32 bytes).
# Generate: openssl rand -base64 32
BRAINROUTER_SECRET_KEY=
# Seed the first admin (clear after first boot; the API key prints once in logs).
BRAINROUTER_ADMIN_PASSWORD=
BRAINROUTER_ADMIN_EMAIL=admin@example.com

# --- Optional ---
BRAINROUTER_PORT=3747
# Which org's DB providers back the brain's own calls (default: seeded admin's personal org).
BRAINROUTER_SYSTEM_ORG_ID=
# Prometheus /metrics ("on") + CORS allowlist for a browser dashboard.
BRAINROUTER_METRICS=
BRAINROUTER_CORS_ORIGIN=

# --- AI providers (ADR-012) ---
# Providers (LLM / embeddings / reranker / judge) are configured in the DB by an
# admin (dashboard → AI Providers), NOT via .env. There are no BRAINROUTER_LLM_*
# provider vars here anymore. (Legacy ones, if still set, are migrated into the DB
# once on first boot, then ignored — delete them afterward.)
