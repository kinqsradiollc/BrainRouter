{
  "name": "dashboard",
  "private": true,
  "version": "0.4.21",
  "type": "module",
  "scripts": {
    "predev": "npm --prefix .. run build:packages:dashboard",
    "dev": "NODE_OPTIONS='--no-deprecation' next dev",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"app/**/*.test.ts\" \"components/**/*.test.tsx\" \"lib/**/*.test.ts\"",
    "start": "next start",
    "build:cf": "node scripts/verify-cf-workspace.mjs && npm --prefix .. run build:packages:dashboard && opennextjs-cloudflare build",
    "cf:preview": "npm run build:cf && opennextjs-cloudflare preview",
    "cf:deploy": "npm run build:cf && wrangler deploy"
  },
  "dependencies": {
    "@kinqs/brainrouter-core": "^0.4.21",
    "@kinqs/brainrouter-hooks": "^0.4.21",
    "@kinqs/brainrouter-sdk": "^0.4.21",
    "@kinqs/brainrouter-types": "^0.4.21",
    "@kinqs/brainrouter-ui": "^0.4.21",
    "@opennextjs/cloudflare": "^1.20.2",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^12.43.0",
    "geist": "^1.7.2",
    "katex": "^0.18.4",
    "mermaid": "^11.17.0",
    "next": "15.5.23",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.0.0"
  }
}
