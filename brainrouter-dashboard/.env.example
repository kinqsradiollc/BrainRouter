# ── BrainRouter Dashboard — environment ──────────────────────────────────────
# Copy to `.env.local` and adjust. Only NEXT_PUBLIC_* vars reach the browser.

# URL of the BrainRouter MCP / HTTP server the dashboard talks to.
NEXT_PUBLIC_API_URL=http://localhost:3747

# ── Static presentation mode ─────────────────────────────────────────────────
# When "true", the dashboard runs as a pure product PREVIEW:
#   • only the marketing pages render (Home `/`, About `/about`)
#   • sign-in / sign-up and the whole authenticated dashboard are disabled
#   • NO API calls are made (it ships standalone, no backend required)
# Use this for a public preview/marketing deployment.
#
# Set to "false" (or leave unset) to run the FULL dashboard locally against a
# BrainRouter server — sign in, browse memories, recall, graph, chat, etc.
#
# (Next.js only exposes vars prefixed NEXT_PUBLIC_ to the browser, so the
#  BRAINROUTER_STATIC_PRESENTATION flag is named NEXT_PUBLIC_… here.)
NEXT_PUBLIC_BRAINROUTER_STATIC_PRESENTATION=false

# ── Cloudflare Workers deploy ────────────────────────────────────────────────
# `npm run build:cf` (or cf:deploy) does a STATIC export — NEXT_PUBLIC_* vars
# are inlined at BUILD time, so set the values you want baked into the bundle
# in the build environment, e.g.:
#   NEXT_PUBLIC_API_URL=https://api.brainrouter.dev npm run cf:deploy
# (a public marketing build would also set NEXT_PUBLIC_BRAINROUTER_STATIC_PRESENTATION=true).
# See DEPLOY-CLOUDFLARE.md.
