{
  // BrainRouter dashboard — deployed as a real Next.js Worker runtime via
  // @opennextjs/cloudflare. This keeps runtime bindings, secrets, triggers, and
  // observability available in Cloudflare while static assets are still served
  // efficiently through the ASSETS binding. Docs: ./DEPLOY-CLOUDFLARE.md
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainrouter-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
