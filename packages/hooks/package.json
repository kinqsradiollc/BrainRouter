{
  "name": "@kinqs/brainrouter-hooks",
  "version": "0.4.22",
  "description": "BrainRouter React hooks — data + state hooks for building a UI on top of a BrainRouter MCP server (pairs with @kinqs/brainrouter-sdk).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"const fs=require('fs');fs.mkdirSync('dist',{recursive:true});for(const entry of fs.readdirSync('dist'))fs.rmSync('dist/'+entry,{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepack": "npm run build && node -e \"const fs=require('fs');function w(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=d+'/'+e.name;if(e.isDirectory())w(p);else if(/\\.test\\./.test(e.name))fs.rmSync(p)}}w('dist')\""
  },
  "dependencies": {
    "@kinqs/brainrouter-sdk": "^0.4.22",
    "@kinqs/brainrouter-types": "^0.4.22"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^19.0.0",
    "@types/react-test-renderer": "^19.1.0",
    "react": "^19.2.6",
    "react-test-renderer": "19.2.6",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "brainrouter",
    "react",
    "hooks",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "author": "BrainRouter contributors",
  "homepage": "https://github.com/kinqsradiollc/BrainRouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinqsradiollc/BrainRouter.git",
    "directory": "packages/hooks"
  },
  "bugs": {
    "url": "https://github.com/kinqsradiollc/BrainRouter/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
