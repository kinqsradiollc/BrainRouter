{
  "name": "@kinqs/brainrouter-types",
  "version": "0.4.16",
  "description": "Shared TypeScript types for BrainRouter — used by the CLI, MCP server, and SDK.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.js"
    },
    "./reviews": {
      "types": "./dist/reviews.d.ts",
      "import": "./dist/reviews.js"
    },
    "./atlas-ops": {
      "types": "./dist/atlas-ops.d.ts",
      "import": "./dist/atlas-ops.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4"
  },
  "keywords": [
    "brainrouter",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "author": "BrainRouter contributors",
  "homepage": "https://github.com/kinqsradiollc/BrainRouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinqsradiollc/BrainRouter.git",
    "directory": "packages/types"
  },
  "bugs": {
    "url": "https://github.com/kinqsradiollc/BrainRouter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
