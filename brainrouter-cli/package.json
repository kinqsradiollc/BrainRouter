{
  "name": "@kinqs/brainrouter-cli",
  "version": "0.4.19",
  "description": "Memory-native terminal coding agent. Talks to the BrainRouter MCP cognitive engine for recall, skills, capture, persona, focus scenes, and contradiction tracking.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "brainrouter": "bin/cli.cjs"
  },
  "files": [
    "agents",
    "packs",
    "bin",
    "changelog",
    "config",
    "dist",
    "README.md",
    "skills",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node ../scripts/bundle-content.mjs --package .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepack": "npm run build && node -e \"const fs=require('fs');function w(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=d+'/'+e.name;if(e.isDirectory())w(p);else if(/\\.test\\./.test(e.name))fs.rmSync(p)}}w('dist')\"",
    "postpack": "node ../scripts/bundle-content.mjs --package . --clean",
    "sync-changelog": "node -e \"fs.rmSync('changelog',{recursive:true,force:true});fs.mkdirSync('changelog',{recursive:true});for(const f of fs.readdirSync('../brainrouter-changelog'))if(f.endsWith('.md'))fs.copyFileSync('../brainrouter-changelog/'+f,'changelog/'+f)\"",
    "prepublishOnly": "npm run sync-changelog"
  },
  "dependencies": {
    "@kinqs/brainrouter-core": "^0.4.19",
    "@kinqs/brainrouter-sdk": "^0.4.19",
    "@kinqs/brainrouter-types": "^0.4.19",
    "@modelcontextprotocol/sdk": "^1.11.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ink": "^7.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "inquirer": "^9.3.2",
    "marked": "^12.0.1",
    "marked-terminal": "^7.0.0",
    "ora": "^8.0.1",
    "react": "^19.2.6",
    "string-width": "^4.2.3",
    "wrap-ansi": "^6.2.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/marked": "^4.0.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.15",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "mcp",
    "model-context-protocol",
    "memory",
    "llm",
    "coding-agent",
    "terminal",
    "brainrouter"
  ],
  "license": "MIT",
  "author": "BrainRouter contributors",
  "homepage": "https://github.com/kinqsradiollc/BrainRouter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kinqsradiollc/BrainRouter.git",
    "directory": "brainrouter-cli"
  },
  "bugs": {
    "url": "https://github.com/kinqsradiollc/BrainRouter/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
