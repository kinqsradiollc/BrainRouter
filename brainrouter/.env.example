# BrainRouter MCP server — environment template
#
# Copy to `brainrouter/.env`. Loaded automatically by `dotenv/config` when
# the MCP server starts. The CLI sets the spawned child's cwd to this
# folder so stdio-launched MCPs also pick it up.
#
# This file is for MCP-SERVER concerns only:
#   1. LLM credentials & endpoint        (shared by every LLM-driven step)
#   2. Retrieval pipeline stages         (embeddings, reranker, judge)
#   3. Memory engine knobs               (storage, decay, distillation, sweeper)
#   4. Skill pre-warming
#   5. Server auth                       (JWT, admin seed, CORS, HTTP MCP key)
#
# CLI agent knobs (sandbox, tool loop limits, web search, etc.) live in
# `brainrouter-cli/.env.example`. Keep them separate so the two processes
# can be configured independently.
#
# All values in this template are blank placeholders. Fill in only what
# you actually need — most settings have sensible defaults.


# =============================================================================
# 1. LLM (cognitive extraction + synthesis + judging)
# =============================================================================
# Shared credential and endpoint for every LLM-driven step on the MCP side:
#   - cognitive extraction   (turn raw conversation into structured memories)
#   - contradiction checks   (detect when a new memory conflicts with an old one)
#   - graph extraction       (pull entities + relations into the knowledge graph)
#   - focus-scene summaries  (group related memories under a scene heading)
#   - persona synthesis      (cross-session identity / "who is this user")
#   - relevance judging      (Stage 3 of retrieval — see section 2 below)
#
# Falls back to OPENAI_API_KEY when BRAINROUTER_LLM_API_KEY is unset.
BRAINROUTER_LLM_API_KEY=

# OpenAI-compatible chat-completions endpoint.
# Examples:
#   OpenAI:     https://api.openai.com/v1/chat/completions
#   OpenRouter: https://openrouter.ai/api/v1/chat/completions
#   LM Studio:  http://localhost:1234/v1/chat/completions
#   Ollama:     http://localhost:11434/v1/chat/completions
BRAINROUTER_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
BRAINROUTER_LLM_MODEL=gpt-4o-mini

# Optional per-task model split. Both inherit BRAINROUTER_LLM_MODEL.
#   - EXTRACTION_MODEL: high-volume, can be cheap/local
#   - SYNTHESIS_MODEL: lower-volume but benefits from smarter models
# BRAINROUTER_EXTRACTION_MODEL=gpt-4o-mini
# BRAINROUTER_SYNTHESIS_MODEL=gpt-4o

# Per-call timeout for MCP-side LLM calls. Cloud endpoints default to 120000
# (2 min). Local OpenAI-compatible endpoints such as LM Studio/Ollama get a
# longer default so slow generations are not aborted while the backend is still
# processing.
# BRAINROUTER_LLM_TIMEOUT_MS=120000
# Cognitive extraction can be slower than short synthesis calls on local
# reasoning models. Set this when extraction needs a different timeout.
# BRAINROUTER_EXTRACTION_TIMEOUT_MS=600000

# Cap on concurrent in-flight LLM calls FROM THE MCP PROCESS.
# Default 2. Set to 1 on consumer hardware running LM Studio with a single
# model; raise to 10+ for cloud APIs.
# BRAINROUTER_LLM_MAX_CONCURRENT=2


# =============================================================================
# 2. Retrieval pipeline (three optional stages)
# =============================================================================
# Each stage layers on top of the always-on FTS5 keyword search. Add them in
# order — every stage raises relevance but also adds latency.
#
#   Stage 1: Embeddings   — semantic vector recall (fused with keyword via RRF)
#   Stage 2: Reranker     — cross-encoder reorders the candidate pool
#   Stage 3: Judge        — LLM approves/rejects each finalist for relevance
#
# Skip any stage by leaving its credentials unset.

# --- Stage 1: Embeddings ----------------------------------------------------
# Vector search runs when an embedding key is available; otherwise the
# pipeline falls back to keyword-only. Falls back to BRAINROUTER_LLM_API_KEY
# when BRAINROUTER_EMBEDDING_API_KEY is unset.
# BRAINROUTER_EMBEDDING_API_KEY=
BRAINROUTER_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
BRAINROUTER_EMBEDDING_MODEL=text-embedding-3-small
BRAINROUTER_EMBEDDING_DIMENSIONS=1536
# Per-call timeout in ms. Default 60000 for cloud endpoints, 120000 for local
# endpoints. Falls back to BRAINROUTER_LLM_TIMEOUT_MS when set.
# BRAINROUTER_EMBEDDING_TIMEOUT_MS=60000

# --- Stage 2: Reranker (optional) -------------------------------------------
# Cross-encoder rescores the candidate pool. Disabled unless a key is set.
# Compatible with Cohere /v1/rerank or any vLLM-style /v1/rerank endpoint.
# BRAINROUTER_RERANKER_API_KEY=
# BRAINROUTER_RERANKER_ENDPOINT=https://api.cohere.com/v1/rerank
# BRAINROUTER_RERANKER_MODEL=rerank-english-v3.0
# BRAINROUTER_RERANKER_TOP_N=10
# Per-call timeout in ms. Default 60000 for cloud endpoints, 120000 for local
# endpoints. Falls back to BRAINROUTER_LLM_TIMEOUT_MS when set.
# BRAINROUTER_RERANKER_TIMEOUT_MS=60000
# Per-doc char budget sent to the cross-encoder (0.4.14). Was a hardcoded 700
# (~180 tokens) that discarded most of a long record; with chunk-on-import
# (section 3) records are chunk-sized, so cover a whole chunk. Default 1500
# (~375 tokens — stays within a 512-token reranker). Clamped to [100, 8000].
# BRAINROUTER_RERANKER_MAX_DOC_CHARS=1500

# --- Stage 3: Relevance judge (optional, off by default) --------------------
# LLM-as-judge gate that runs AFTER the reranker and drops candidates that
# aren't actually relevant to the query. The reranker only re-orders; it
# never filters — so a memory sharing vocabulary with the query but about
# a different subject still makes it through. The judge fixes that.
#
# Adds one extra LLM call per recall: ~500ms-1s on a small/fast model.
# Falls back to BRAINROUTER_LLM_* unless explicitly overridden, so a single
# credential covers extraction, synthesis, and judging by default.
# BRAINROUTER_RELEVANCE_JUDGE_ENABLED=true
# BRAINROUTER_RELEVANCE_JUDGE_API_KEY=
# BRAINROUTER_RELEVANCE_JUDGE_ENDPOINT=https://api.openai.com/v1/chat/completions
# BRAINROUTER_RELEVANCE_JUDGE_MODEL=gpt-4o-mini
# Max candidates sent to the judge in a single batched call. Default 10.
# BRAINROUTER_RELEVANCE_JUDGE_MAX_CANDIDATES=10
# Result floor (0.4.14): if the judge approves fewer than this many candidates,
# keep the top pre-judge (reranker/RRF) results so recall never collapses to 0
# on long records the judge can't verify in its 600-char window. Default 1.
# Set 0 for the old collapse-to-zero behavior. The judge's precision trimming on
# short records is unaffected (the floor only engages when approvals < this).
# BRAINROUTER_RELEVANCE_JUDGE_MIN_KEEP=1
# Per-call timeout in ms. Default 15000 for cloud endpoints, 120000 for local
# endpoints.
# BRAINROUTER_RELEVANCE_JUDGE_TIMEOUT_MS=15000

# --- Pipeline width knobs (how many candidates flow through each stage) -----
# Used to be hardcoded `15 / 15 / 20 / 5` in brainrouter/src/memory/recall.ts.
# Each value is clamped to [1, 200] to keep typos from blowing up the LLM
# judge call. Increase these when you want recall to consider a wider pool;
# decrease on local hardware to cut per-recall latency.
#   BRAINROUTER_RECALL_FTS_LIMIT     — Stage 1 FTS5 BM25 top-K. Default 15.
#   BRAINROUTER_RECALL_VEC_LIMIT     — Stage 1 vector top-K (only used when
#                                       Stage 1 embeddings are enabled).
#                                       Default 15.
#   BRAINROUTER_RECALL_RERANK_POOL   — Stage 2 reranker INPUT pool size.
#                                       Default 20. The reranker's own output
#                                       count is BRAINROUTER_RERANKER_TOP_N.
#   BRAINROUTER_RECALL_TOP_RESULTS   — final result count when no reranker is
#                                       configured. Default 5.
# BRAINROUTER_RECALL_FTS_LIMIT=15
# BRAINROUTER_RECALL_VEC_LIMIT=15
# BRAINROUTER_RECALL_RERANK_POOL=20
# BRAINROUTER_RECALL_TOP_RESULTS=5

# --- Local selection stage (0.4.3) — no cross-encoder API key required -------
# When NO reranker key is set (the default), recall picks the final top-K with
# a local, no-network pass: it demotes candidates that share few salient tokens
# with the query (generic boilerplate → near-0), then runs MMR so the result is
# diverse — which also collapses near-duplicate records ("5× the same fact").
# Zero added latency (token-set math). No effect when a reranker key is set.
#   BRAINROUTER_RECALL_DIVERSITY         — on | off. Default on. `off` reverts
#                                          to plain top-K by composite score.
#   BRAINROUTER_RECALL_DIVERSITY_LAMBDA  — MMR tradeoff in [0,1]. 1 = pure
#                                          relevance (no diversity), 0 = pure
#                                          diversity. Default 0.7.
# BRAINROUTER_RECALL_DIVERSITY=on
# BRAINROUTER_RECALL_DIVERSITY_LAMBDA=0.7


# =============================================================================
# 3. Memory engine
# =============================================================================

# --- Storage paths ----------------------------------------------------------
# SQLite memory store path. Default: ~/.brainrouter/memory.db.
# BRAINROUTER_MEMORY_DB=/path/to/memory.db
# Override per-user state root. Default: ~/.brainrouter.
# BRAINROUTER_HOME=/path/to/state

# --- Import (memory_import) -------------------------------------------------
# Chunk over-long records on import (0.4.14) so the recall stages work on focused
# units — one long blob breaks the reranker (truncates), the judge (600-char
# window) and the single-vector embedding. Records whose content exceeds this
# many chars are split into chunk records (child id `${parent}::c{i}`; parent +
# chunkIndex kept in metadata; recall rolls a chunk back to its parent). Short
# records pass through unchanged. Default 1500. Set 0 to disable chunking.
# BRAINROUTER_IMPORT_CHUNK_CHARS=1500
# Embed imported records immediately (0.4.14) so they're vector-searchable right
# away instead of waiting on the background re-embed sweep (which lags far behind
# a bulk import → vector recall finds nothing). Default on. Set 0 for fast bulk
# restores — vectors then backfill via the sweep.
# BRAINROUTER_IMPORT_EMBED=1
# Bulk-embed worker-pool size (0.4.14) for import + the startup re-embed sweep.
# Default 8. Effective concurrency is min(this, BRAINROUTER_LLM_MAX_CONCURRENT) —
# raise that cap to actually embed faster on a capable embedder.
# BRAINROUTER_EMBED_CONCURRENCY=8
# Workspace root when MCP --root is omitted.
# BRAINROUTER_LOCAL_ROOT=/path/to/your/project

# --- Knowledge graph + contradictions ---------------------------------------
# Disable GraphRAG (2-hop entity expansion) by setting to false. Default true.
# BRAINROUTER_GRAPH_ENABLED=true
# BRAINROUTER_GRAPH_TIMEOUT_MS=120000
# BRAINROUTER_CONTRADICTION_TIMEOUT_MS=60000

# --- Neural sparks (spreading activation) -----------------------------------
# 2-hop spreading activation: records firing above threshold pull connected
# memories into the candidate pool, co-cited pairs strengthen (Hebbian LTP),
# and idle connections decay/prune (LTD). Set to false to rank on the plain
# scored/reranked set instead. Default true.
# BRAINROUTER_NEURAL_SPARK_ENABLED=true

# --- ACE feedback (auto-archive uncited memories) ---------------------------
# Memories surfaced in recall this many times without being cited by the
# agent get auto-archived. 0 disables. Default 10.
# BRAINROUTER_ACE_ARCHIVE_THRESHOLD=10

# --- Distillation triggers --------------------------------------------------
# Focus-scene summary — groups related cognitives under a scene heading.
# Fires once every N new cognitive records.
# BRAINROUTER_FOCUS_TRIGGER_N=10
# BRAINROUTER_MAX_FOCUS_SCENES=20

# Persona synthesis — cross-session identity summary ("who is this user").
# Fires once every N new cognitive records.
# BRAINROUTER_IDENTITY_TRIGGER_N=50
# In-memory persona cache lifetime. Default 3600000 (1h).
# BRAINROUTER_PERSONA_CACHE_TTL_MS=3600000

# --- Extraction backlog sweeper ---------------------------------------------
# Background job that runs cognitive extraction over sensory rows the
# per-turn extractor missed (errored, skipped, or interrupted).
# BRAINROUTER_DISABLE_EXTRACTION_SWEEPER=true
# BRAINROUTER_EXTRACTION_SWEEP_INTERVAL_MS=300000   # floor: 30000
# BRAINROUTER_EXTRACTION_SWEEP_MIN_AGE_MS=120000
# BRAINROUTER_EXTRACTION_MAX_FAILURES=5


# =============================================================================
# 4. Skill pre-warming (optional, off by default)
# =============================================================================
# Memetic skill activation — repeatedly invoking a skill heats it up so its
# memory hints get pre-injected into context. Half-life decay keeps cold
# skills from polluting the prompt.
# BRAINROUTER_PREWARM_ENABLED=true
# BRAINROUTER_SKILL_HALF_LIFE_MINUTES=10
# BRAINROUTER_SKILL_MIN_TURN_DECAY=0.05
# BRAINROUTER_SKILL_PREWARM_THRESHOLD=0.3
# BRAINROUTER_SKILL_SPIKE_AMOUNT=1.0
# BRAINROUTER_SKILL_MAX_POTENTIAL=4.0


# =============================================================================
# 5. Server auth (HTTP MCP + dashboard)
# =============================================================================
# Only needed if you run the HTTP MCP transport or the web dashboard.
# Stdio MCP (the default transport) doesn't use any of these.

# Seeded admin (used when the users table is empty and by scripts/setup-admin.js).
BRAINROUTER_DEFAULT_ADMIN_USER_ID=admin
BRAINROUTER_ADMIN_EMAIL=admin@example.com
# Set on first boot to seed the admin password — leave blank afterward.
BRAINROUTER_ADMIN_PASSWORD=

# JWT signing key for dashboard sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, the server generates a random secret per boot and sessions do
# not survive restarts.
BRAINROUTER_JWT_SECRET=
# BRAINROUTER_JWT_EXPIRES_SECS=86400

# Dashboard CORS allowlist.
BRAINROUTER_CORS_ORIGIN=http://localhost:3000

# API key for HTTP MCP transport clients. Usually configured in the client,
# not here. Reset with: npm run setup:admin -- --reset --userId admin
# BRAINROUTER_API_KEY=

# Stdio fallback user id when no authenticated user mapping is available.
# Prefer BRAINROUTER_API_KEY instead.
# BRAINROUTER_USER_ID=default

# ─────────────────────────────────────────────────────────────────────────────
# Background jobs, sweepers & dedup (all optional — sensible defaults shown)
# ─────────────────────────────────────────────────────────────────────────────

# In-process brain job runner (extraction, dedup, graph, focus/identity
# distill, and the 0.4.3 depth jobs). Set to "off" to disable (e.g. in tests
# or when an external runner drives jobs). Default: on.
# BRAINROUTER_JOB_RUNNER=off
# BRAINROUTER_JOB_RUNNER_INTERVAL_MS=300000

# Auto-schedule the maintenance depth agents (0.4.3): the job runner enqueues
# blackboard_reconciler per user when candidates are pending, and vault_exporter
# ~hourly, so the vault mirror + blackboard commits stay fresh without a manual
# memory_agent_run. (tree_sealer stays on-demand — nothing auto-appends tree
# leaves yet.) Set to "off" to disable all auto-enqueue. Default: on (requires
# the job runner above to be running).
# BRAINROUTER_JOB_MAINTENANCE=off

# Scene-tree autobuild (0.4.3): during the maintenance pass, grow a durable
# memory-summary tree over cognitive records — one leaf per mature scene — and
# enqueue tree_sealer to seal full buckets into parent summaries. Built over
# records (not transcripts, which churn/prune). Set "off" to disable (the tree
# can still be built/sealed on demand via memory_tree_walk / memory_agent_run).
# Default: on (requires the job runner + maintenance above).
# BRAINROUTER_TREE_AUTOBUILD=off
#
# MEM-20 — scene-tree build/seal thresholds (the source/topic/global domain
# policy lives in memory/tree/policy.ts). Scene leaves are topic-domain and seal
# into a global parent. Defaults shown.
# BRAINROUTER_TREE_MIN_SCENE_RECORDS=3   # min records before a scene gets a leaf
# BRAINROUTER_TREE_LEAF_PER_PASS=5       # max leaves built per maintenance tick
# BRAINROUTER_TREE_SEAL_THRESHOLD=6      # unsealed topic leaves that EAGERLY seal
# BRAINROUTER_TREE_IDLE_SEAL_FLOOR=2     # MEM-10b — seal a SETTLED bucket (a pass
#                                        # added no new leaf) once it has this many
#                                        # unsealed leaves, even below the eager
#                                        # threshold; without it a handful of scenes
#                                        # would never seal → tree_sealer/tree_digest
#                                        # stay idle. Set high to require full buckets.

# MEM-10b — auto-schedule the retrieval benchmark (benchmark_eval) from scheduled
# maintenance: an early pass for first-run visibility, then ~daily. Expensive
# (up to ~5 min/run), so set "off" to keep benchmark_eval on-demand only.
# BRAINROUTER_BENCH_SCHEDULE=off

# Apply-time dedup guard for newly extracted records: off | strict | fuzzy.
# Default: off (LLM dedup still runs; this is a deterministic second pass).
# BRAINROUTER_DEDUP_MODE=off

# Stale-session sweeper (clears dead federation sessions). "true" disables it.
# BRAINROUTER_DISABLE_SESSION_SWEEPER=true
# BRAINROUTER_SESSION_SWEEP_INTERVAL_MS=60000     # poll interval (default 1 min)
# BRAINROUTER_SESSION_SWEEP_MAX_AGE_MS=300000     # evict after (default 5 min)

# Inbox sweeper (clears delivered/old cross-session messages). "true" disables.
# BRAINROUTER_DISABLE_INBOX_SWEEPER=true
# BRAINROUTER_INBOX_SWEEP_INTERVAL_MS=300000      # poll interval (default 5 min)
# BRAINROUTER_INBOX_SWEEP_MAX_AGE_MS=3600000      # evict after (default 1 hour)

# Override which env file the loader reads (default ~/.config/brainrouter/server.env).
# BRAINROUTER_ENV_FILE=/abs/path/to/server.env
