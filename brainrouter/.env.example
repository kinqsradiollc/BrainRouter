# BrainRouter MCP server — environment template
#
# Copy to ~/.config/brainrouter/server.env  (or brainrouter/.env for monorepo dev).
# Loaded automatically when the MCP server starts.
#
# Only the LLM block (section 1) is required. Everything else is optional and
# has a sensible default — shown after each var. Uncomment a line ONLY to change
# it. CLI agent knobs live in config.json (cli.*), not here.
#
# Full reference + provider recipes: brainrouter-docs/configuration.md


# ── 1. LLM (required) ─────────────────────────────────────────────────────────
# One OpenAI-compatible chat endpoint serves every LLM step: cognitive
# extraction, contradiction checks, graph extraction, persona/focus synthesis,
# and the relevance judge. Falls back to OPENAI_API_KEY when the key is unset.
BRAINROUTER_LLM_API_KEY=
BRAINROUTER_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
BRAINROUTER_LLM_MODEL=gpt-4o-mini
# BRAINROUTER_EXTRACTION_MODEL=            # per-task model split (default: LLM_MODEL)
# BRAINROUTER_SYNTHESIS_MODEL=             # per-task model split (default: LLM_MODEL)
# BRAINROUTER_LLM_TIMEOUT_MS=120000        # per-call timeout (cloud); 2 min
# BRAINROUTER_LOCAL_LLM_MIN_TIMEOUT_MS=600000  # timeout floor for localhost endpoints (10 min)
# BRAINROUTER_LLM_MAX_CONCURRENT=2         # in-flight LLM cap — 1 for single-GPU LM Studio, 10+ for cloud
# BRAINROUTER_INLINE_EXTRACTION=           # "on" blocks capture on extraction (debug); default off = background


# ── 2. Retrieval pipeline (optional — layered on always-on keyword search) ────
# Stage 1 · Embeddings — semantic vector recall (falls back to the LLM key)
# BRAINROUTER_EMBEDDING_API_KEY=
BRAINROUTER_EMBEDDING_ENDPOINT=https://api.openai.com/v1/embeddings
BRAINROUTER_EMBEDDING_MODEL=text-embedding-3-small
BRAINROUTER_EMBEDDING_DIMENSIONS=1536
# BRAINROUTER_EMBEDDING_TIMEOUT_MS=30000        # bounded; never inherits the 10-min local floor
#
# Stage 2 · Reranker — cross-encoder rescoring (off unless a key is set)
# BRAINROUTER_RERANKER_API_KEY=
# BRAINROUTER_RERANKER_ENDPOINT=https://api.cohere.com/v1/rerank
# BRAINROUTER_RERANKER_MODEL=rerank-english-v3.0
# BRAINROUTER_RERANKER_TOP_N=5
# BRAINROUTER_RERANKER_TIMEOUT_MS=25000          # per-call timeout; raised 15000→25000 (SPEC 01) for CPU cross-encoders under multi-agent load. Lower (10000-15000) for GPU/Cohere.
# BRAINROUTER_RERANKER_MAX_CONCURRENT=1          # cap-1 by default (single-worker CPU). Raise only on a GPU/vLLM backend.
# BRAINROUTER_RERANKER_ACQUIRE_WAIT_MS=15000     # SPEC 01: max wait for the (cap-1) reranker slot before shedding to RRF — keeps recall responsive under parallel load instead of stalling.
# BRAINROUTER_RERANKER_BREAKER_THRESHOLD=3       # skip the reranker after N consecutive failures…
# BRAINROUTER_RERANKER_BREAKER_COOLDOWN_MS=30000 # …for this long (recall uses RRF, no per-call wait)
#
# Stage 3 · Relevance judge — LLM relevance filter (off by default; falls back to LLM_*)
# BRAINROUTER_RELEVANCE_JUDGE_ENABLED=false
# BRAINROUTER_RELEVANCE_JUDGE_MODEL=gpt-4o-mini
# BRAINROUTER_RELEVANCE_JUDGE_MAX_CANDIDATES=10
# BRAINROUTER_RELEVANCE_JUDGE_TIMEOUT_MS=15000
#
# Recall widths + local diversity selection (full set: configuration.md)
# BRAINROUTER_RECALL_TOP_RESULTS=5
# BRAINROUTER_RECALL_DIVERSITY=on


# ── 3. Memory engine (optional) ───────────────────────────────────────────────
# BRAINROUTER_MEMORY_DB=                   # SQLite path (default ~/.brainrouter/memory.db)
# BRAINROUTER_HOME=                        # state root (default ~/.brainrouter)
# BRAINROUTER_GRAPH_ENABLED=true           # GraphRAG 2-hop entity expansion
# BRAINROUTER_GRAPH_TIMEOUT_MS=120000
# BRAINROUTER_CONTRADICTION_TIMEOUT_MS=60000
# BRAINROUTER_CONTRADICTION_MAX_CANDIDATES=3   # records compared per new memory (1 LLM call each)
# BRAINROUTER_NEURAL_SPARK_ENABLED=true        # spreading-activation recall
# BRAINROUTER_ACE_ARCHIVE_THRESHOLD=10         # auto-archive after N uncited recalls (0 = off)
# BRAINROUTER_BLACKBOARD_ADMISSION=on          # "off" admits every extracted record (skip staging)
# Distillation triggers — fire once every N new cognitive records:
# BRAINROUTER_FOCUS_TRIGGER_N=10
# BRAINROUTER_IDENTITY_TRIGGER_N=50
# BRAINROUTER_MAX_FOCUS_SCENES=20
# BRAINROUTER_PERSONA_CACHE_TTL_MS=3600000
# Extraction backlog sweeper — re-runs extraction for sensory rows the per-turn pass missed:
# BRAINROUTER_DISABLE_EXTRACTION_SWEEPER=false
# BRAINROUTER_EXTRACTION_TIMEOUT_MS=600000
# BRAINROUTER_EXTRACTION_SWEEP_INTERVAL_MS=300000


# ── 4. Background jobs + sweepers (optional; defaults are sensible) ────────────
# BRAINROUTER_JOB_RUNNER=on                # in-process runner (extraction/graph/focus/depth jobs)
# BRAINROUTER_JOB_MAINTENANCE=on           # auto-enqueue depth-maintenance agents
# BRAINROUTER_TREE_AUTOBUILD=on            # build the memory-summary tree during maintenance
# BRAINROUTER_DISABLE_SESSION_SWEEPER=false  # federation stale-session cleanup
# BRAINROUTER_DISABLE_INBOX_SWEEPER=false    # cross-session inbox cleanup


# ── 5. Skill pre-warming (optional, off by default) ───────────────────────────
# BRAINROUTER_PREWARM_ENABLED=true
# BRAINROUTER_SKILL_HALF_LIFE_MINUTES=10
# (spike / decay / threshold knobs: BRAINROUTER_SKILL_* — see configuration.md)


# ── 6. Server auth (HTTP MCP transport + dashboard only; stdio ignores these) ──
# BRAINROUTER_ADMIN_PASSWORD=              # set once on first boot to seed the admin, then clear
# BRAINROUTER_ADMIN_EMAIL=admin@example.com
# BRAINROUTER_JWT_SECRET=                  # 32-byte hex; REQUIRED in production (else random per-boot → sessions reset)
# BRAINROUTER_JWT_EXPIRES_SECS=3600
# BRAINROUTER_REFRESH_EXPIRES_SECS=2592000   # refresh-token TTL (30 days)
# BRAINROUTER_CORS_ORIGIN=http://localhost:3000
# BRAINROUTER_RATE_LIMIT_MAX=600           # requests per window across /api /v1 /mcp
# BRAINROUTER_RATE_LIMIT_WINDOW_MS=60000
# BRAINROUTER_API_KEY=                     # HTTP MCP client key (usually set in the client, not here)
# BRAINROUTER_USER_ID=default              # stdio fallback user id
# BRAINROUTER_ENV_FILE=                    # override which .env the loader reads
