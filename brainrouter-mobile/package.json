{
  "name": "brainrouter-mobile",
  "version": "0.4.15",
  "private": true,
  "description": "BrainRouter Mobile — a thin Expo/React Native client for the remote brainrouter-host agent runtime.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:domain": "tsc -p tsconfig.domain.json --noEmit",
    "test": "jest",
    "test:domain": "node scripts/test-domain.mjs"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.0.6",
    "@kinqs/brainrouter-agent-protocol": "*",
    "@kinqs/brainrouter-types": "*",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@shopify/flash-list": "1.7.2",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.0",
    "expo-document-picker": "~13.0.1",
    "expo-image-picker": "~16.0.3",
    "expo-notifications": "~0.29.11",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-mmkv": "^3.1.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-syntax-highlighter": "^2.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~18.3.12",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
